# Baseline single-stage image — kept only for before/after size comparison.
# Use Dockerfile (multi-stage) for all real builds.
FROM python:3.13

WORKDIR /app

COPY d_ml/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY d_ml/api/ .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
